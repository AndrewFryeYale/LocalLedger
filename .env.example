# Copy to .env (never commit .env). Shell environment variables take precedence over this file.

# --- LLM (Portkey gateway, OpenAI-compatible API) ---------------------------------------------
# PORTKEY_API_KEY=            # set in your shell or here; never commit it
LLM_PROVIDER=portkey          # portkey | mock  (mock = deterministic, no API calls)
LLM_BASE_URL=https://api.portkey.ai/v1
LLM_MODEL_HEAVY=gpt-5.6-luna  # war-room synthesis + note writer
LLM_MODEL_FAST=gpt-5.6-luna   # extraction, summaries, fact-check
LLM_BUDGET_USD=10             # hard project cap; LLM steps degrade to mock once reached
LLM_PRICE_IN_PER_MTOK=3.0     # used for the cost ledger estimate; set to your negotiated price
LLM_PRICE_OUT_PER_MTOK=15.0

# --- Brand / identity (declared User-Agent: "<BRAND_NAME> research <CONTACT_EMAIL>") ----------
BRAND_NAME=Local Ledger
CONTACT_EMAIL=aceamf25@gmail.com

# --- Web app -----------------------------------------------------------------------------------
PILOT_PASSCODE=ledger-pilot   # shared pilot passcode (change before sharing)
ADMIN_PASSCODE=ledger-admin   # admin pages (metrics, CSV exports)
SECRET_KEY=change-me          # cookie signing; use a long random string in production
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/localledger   # default: sqlite:///./localledger.db

# --- Pipeline knobs ----------------------------------------------------------------------------
SIGNAL_NOTE_THRESHOLD=0.55    # signals at/above this get an analyst note
MAX_NOTES_PER_RUN=20          # budget guard
PRIORITY_WEIGHT=0.35          # rank = ((1-w)*significance + w*priority) * recency
BLACKOUT_DAYS=3               # trading blackout reminder around publication
FEATURE_LIVE_AUDIO=0          # stretch: live audio -> transcript in the war room
