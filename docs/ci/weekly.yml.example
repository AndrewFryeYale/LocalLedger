# Sample weekly pipeline, kept as an example (not installed). To use: copy to .github/workflows/weekly.yml, remove `if: false`, add PORTKEY_API_KEY as a repository secret.
name: weekly-pipeline
on:
  workflow_dispatch:
  # schedule:
  #   - cron: "0 11 * * 1"
jobs:
  pipeline:
    if: false
    runs-on: ubuntu-latest
    env:
      PORTKEY_API_KEY: ${{ secrets.PORTKEY_API_KEY }}
      LLM_BUDGET_USD: "10"
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: {python-version: "3.12"}
      - run: make setup
      - run: make seed ingest signals newsletter
      - uses: actions/upload-artifact@v4
        with: {name: newsletter, path: out/newsletter/}
  tests:
    runs-on: ubuntu-latest
    if: false
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: {python-version: "3.12"}
      - run: pip install -e ".[dev]" && ruff check src tests && pytest -q
